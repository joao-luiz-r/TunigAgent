PORT=3001
# Chave da API (OpenRouter ou DeepSeek oficial)
DEEPSEEK_API_KEY=
# Base URL: https://openrouter.ai/api/v1 (OpenRouter) ou https://api.deepseek.com (oficial)
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
# Modelo: deepseek/deepseek-v4-flash-0731 (V4 Flash, recomendado) ou deepseek/deepseek-chat-v3-0324:free (gratuito)
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash-0731
MONGODB_URI=mongodb://127.0.0.1:27017/tuning_agent
MAX_CONTEXT_TOKENS=12000
LLM_TIMEOUT_MS=120000
# true apenas para testes locais sem API; false para usar o LLM real (obrigatório em produção)
LLM_MOCK=false
MONGODB_MEMORY_FALLBACK=true
